# Backend API URL (must serve the Express API, not the React frontend)
# npm run dev defaults to the local API via .env.development.
VITE_API_URL=http://localhost:3000/api/v1

# Auth0 Configuration
VITE_AUTH0_DOMAIN=toodle-dev.uk.auth0.com
VITE_AUTH0_CLIENT_ID=YourAuth0ClientIDHere
VITE_AUTH0_AUDIENCE=https://api.toodle.com
# Login returns to the current browser origin + /callback automatically.
# Register each environment's callback, logout URL, and web origin in Auth0.
