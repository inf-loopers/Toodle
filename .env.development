# Backend API URL
VITE_API_URL=http://localhost:3000/api/v1

# Auth0 Configuration
VITE_AUTH0_DOMAIN=toodle-dev.uk.auth0.com
VITE_AUTH0_CLIENT_ID=YourAuth0ClientIDHere
